FROM python@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ARGOS_MODEL_DIR=/opt/models/en_es \
    SPAREHOUR_TRANSLATE_DEVICE_OVERRIDE=cpu

COPY dist/sparehour-*.whl /tmp/
RUN python3 -m pip install --no-cache-dir \
      /tmp/sparehour-*.whl \
      ctranslate2==4.8.1 \
      sentencepiece==0.2.2 \
      sacremoses==0.1.1 \
      subword-nmt==0.3.8 \
    && rm /tmp/sparehour-*.whl
COPY state/model-packs/en_es/ /opt/models/en_es/

ENTRYPOINT ["sparehour"]
CMD ["--help"]
