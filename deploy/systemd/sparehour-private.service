[Unit]
Description=Sparehour private operator control plane
Documentation=file:///opt/sparehour/README.md
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/opt/sparehour
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/sparehour/controller.env
SupplementaryGroups=sparehour
ExecStart=/opt/sparehour/.venv/bin/sparehour serve \
  --db /opt/sparehour/state/control.sqlite3 \
  --workloads /opt/sparehour/workloads \
  --artifacts /opt/sparehour/state/artifacts \
  --pools /opt/sparehour/pools \
  --bootstrap-dir /opt/sparehour/dist \
  --dashboard --host 127.0.0.1 --port 8088 --log-level warning
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGINT
# Runtime state is shared with the isolated public process through group sparehour.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
