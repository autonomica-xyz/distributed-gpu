# Install as /etc/sparehour/controller.env, owned by root with mode 0600.
# This file is loaded only by sparehour-private.service.
SPAREHOUR_PUBLIC_URL=https://gpu-control.example.com
SPAREHOUR_WHEEL_URL=https://gpu-control.example.com/bootstrap/sparehour-0.1.0-py3-none-any.whl
# Reconcile provider inventory and worker registration in the private process.
SPAREHOUR_DEPLOYMENT_RECONCILE_SECONDS=15
VAST_API_KEY=replace-me
SALAD_API_KEY=replace-me
SALAD_ORGANIZATION=replace-me
SALAD_PROJECT=replace-me
